package workouts

import (
	"github.com/invopop/ctxi18n/i18n"
	"github.com/jovandeginste/workout-tracker/v2/pkg/database"
	"github.com/jovandeginste/workout-tracker/v2/views/helpers"
	"github.com/jovandeginste/workout-tracker/v2/views/partials"
)

templ List(workouts []*database.Workout, filters *database.WorkoutFilters, total int64, annees []database.ResumeAnnee) {
	@partials.Page(partials.NewPageOptions()) {
		<div class="entete-liste">
			<h2>
				{ i18n.T(ctx, "menu.Workouts") }
				<span class="compte">{ helpers.A2S(total) }</span>
			</h2>
			<a class="action" href={ templ.SafeURL(helpers.RouteFor(ctx, "workout-add")) }>
				@helpers.IconFor("add")
				{ i18n.T(ctx, "translation.Add_workout") }
			</a>
		</div>
		@RailAnnees(filters, annees)
		@BarreFiltres(filters)
		if len(workouts) == 0 {
			<p class="liste-vide">{ i18n.T(ctx, "translation.No_workout_found") }</p>
		}
		<div class="workout-feed">
			for _, w := range workouts {
				@Card(w)
			}
		</div>
		@Pagination(filters, total)
	}
}

// RailAnnees : le carnet couvre plusieurs annees, c'est le premier axe de
// lecture. Une annee tient en cinq a sept pages, la ou le carnet entier en
// demande quarante.
templ RailAnnees(filters *database.WorkoutFilters, annees []database.ResumeAnnee) {
	if len(annees) > 1 {
		{{ base := helpers.RouteFor(ctx, "workouts") }}
		<nav class="rail-annees">
			<a
				href={ templ.SafeURL(LienListe(base, filters, "year", "")) }
				class={ templ.KV("actif", filters.Year == "") }
			>
				{ i18n.T(ctx, "translation.All_years") }
			</a>
			for _, a := range annees {
				<a
					href={ templ.SafeURL(LienListe(base, filters, "year", a.Annee)) }
					class={ templ.KV("actif", filters.Year == a.Annee) }
					title={ i18n.T(ctx, "translation.d_workouts", a.Seances) }
				>
					{ a.Annee }
				</a>
			}
		</nav>
	}
}

// BarreFiltres remplace le bloc depliant d'origine : les criteres tiennent sur
// une ligne et s'appliquent des qu'on en change (frontend/src/common.js).
templ BarreFiltres(filters *database.WorkoutFilters) {
	<form
		class="barre-filtres"
		method="get"
		action={ templ.SafeURL(helpers.RouteFor(ctx, "workouts")) }
		data-auto-submit
	>
		if filters.Year != "" {
			<input type="hidden" name="year" value={ filters.Year }/>
		}
		<label for="type">{ i18n.T(ctx, "translation.Type") }</label>
		<select id="type" name="type">
			<option value="">{ i18n.T(ctx, "translation.All") }</option>
			for _, wt := range helpers.WorkoutTypes() {
				<option value={ wt.String() } selected?={ wt.String() == filters.Type.String() }>
					{ i18n.T(ctx, wt.StringT()) }
				</option>
			}
		</select>
		<label for="order_by">{ i18n.T(ctx, "translation.Sort_by") }</label>
		<select id="order_by" name="order_by">
			for _, o := range helpers.OrderByOptions() {
				<option value={ o.Key } selected?={ o.Key == filters.OrderBy }>
					{ i18n.T(ctx, o.Translation) }
				</option>
			}
		</select>
		<select id="order_dir" name="order_dir" aria-label={ i18n.T(ctx, "translation.Sort_by") }>
			for _, o := range helpers.OrderDirOptions() {
				<option value={ o.Key } selected?={ o.Key == filters.OrderDir }>
					{ i18n.T(ctx, o.Translation) }
				</option>
			}
		</select>
		<noscript>
			<button type="submit">{ i18n.T(ctx, "translation.Filter") }</button>
		</noscript>
	</form>
}

templ Pagination(filters *database.WorkoutFilters, total int64) {
	{{ pages := Pages(total) }}
	if pages > 1 {
		{{ base := helpers.RouteFor(ctx, "workouts") }}
		<nav class="pagination">
			if filters.Page > 1 {
				<a href={ templ.SafeURL(LienPage(base, filters, filters.Page-1)) } rel="prev">
					{ "← " + i18n.T(ctx, "translation.Previous") }
				</a>
			} else {
				<span class="inactif">{ "← " + i18n.T(ctx, "translation.Previous") }</span>
			}
			<span class="position">{ i18n.T(ctx, "translation.Page_d_of_d", filters.Page, pages) }</span>
			if filters.Page < pages {
				<a href={ templ.SafeURL(LienPage(base, filters, filters.Page+1)) } rel="next">
					{ i18n.T(ctx, "translation.Next") + " →" }
				</a>
			} else {
				<span class="inactif">{ i18n.T(ctx, "translation.Next") + " →" }</span>
			}
		</nav>
	}
}

// Card presente une seance dans la liste : le trace sert de signature visuelle,
// on reconnait une sortie a sa forme avant meme de lire son titre.
//
// Les six boutons d'action de chaque carte -- verrouiller, telecharger,
// modifier, recalculer, creer un segment, supprimer -- ont ete retires : ils
// faisaient cent quarante boutons sur une page de vingt-quatre seances, pour
// des gestes qui se font depuis la seance elle-meme.
templ Card(w *database.Workout) {
	{{ photos := helpers.ImagesInNotes(w.Notes, 5) }}
	{{ totalPhotos := helpers.CountImagesInNotes(w.Notes) }}
	<article class="workout-card">
		<a
			class="carte-trace"
			href={ templ.SafeURL(helpers.RouteFor(ctx, "workout-show", w.ID)) }
			aria-hidden="true"
			tabindex="-1"
		>
			if w.Type.IsLocation() {
				<img
					src={ helpers.RouteFor(ctx, "workout-trace", w.ID) }
					loading="lazy"
					decoding="async"
					width="232"
					height="152"
					alt=""
				/>
			} else {
				<span class="sans-trace">
					@helpers.IconFor(w.Type.String())
				</span>
			}
		</a>
		<div class="corps">
			<p class="ligne-type">
				<span class="type">
					if w.HasCustomType() {
						{ w.CustomType }
					} else {
						{ i18n.T(ctx, w.Type.StringT()) }
					}
				</span>
				<span class="pastille"></span>
				@partials.SnippetDate(w.Date)
				if w.Type.IsLocation() && w.Address() != "" {
					<span class="pastille"></span>
					<span class="lieu">{ w.Address() }</span>
				}
				if w.Dirty {
					<span class="dirty" title={ i18n.T(ctx, "translation.refresh_in_progress") }>
						@helpers.IconFor("refresh")
					</span>
				}
			</p>
			<h3 class="titre">
				<a href={ templ.SafeURL(helpers.RouteFor(ctx, "workout-show", w.ID)) }>
					@Name(w, 0)
				</a>
			</h3>
			@CardFigures(w)
			if len(photos) > 0 {
				<div class="bande-photos">
					for _, url := range photos {
						<img src={ url } loading="lazy" decoding="async" alt=""/>
					}
					if totalPhotos > len(photos) {
						<span class="reste">+{ helpers.A2S(totalPhotos - len(photos)) }</span>
					}
				</div>
			}
		</div>
	</article>
}

// CardFigures aligne les chiffres d'une seance : valeur en gros, unite en petit,
// libelle dessous. Remplace la rangee d'icones difficile a comparer d'une carte
// a l'autre.
templ CardFigures(w *database.Workout) {
	{{ preferredUnits := helpers.CurrentUser(ctx).PreferredUnits() }}
	<div class="chiffres">
		if w.Type.IsDistance() {
			<div class="chiffre majeur">
				<span class="valeur">
					{ helpers.HumanDistanceForWorkout(ctx, w, w.TotalDistance()) }
					<span class="unite">{ helpers.DistanceUnitForWorkout(ctx, w) }</span>
				</span>
				<span class="libelle">{ i18n.T(ctx, "translation.Distance") }</span>
			</div>
		}
		if w.Type.IsLocation() && w.TotalUp() != 0 {
			<div class="chiffre">
				<span class="valeur">
					{ helpers.HumanElevation(ctx, w.TotalUp()) }
					<span class="unite">{ preferredUnits.Elevation() }</span>
				</span>
				<span class="libelle">{ i18n.T(ctx, "translation.Total_up") }</span>
			</div>
		}
		if w.Type.IsDuration() {
			<div class="chiffre">
				<span class="valeur">{ helpers.HumanDuration(w.TotalDuration()) }</span>
				<span class="libelle">{ i18n.T(ctx, "translation.Duration") }</span>
			</div>
		}
		if w.Type.IsDistance() && w.Type.IsDuration() {
			<div class="chiffre">
				<span class="valeur">
					@partials.PreferredAverageSpeedMetric(w, preferredUnits)
				</span>
				<span class="libelle">{ i18n.T(ctx, "translation.Average_speed") }</span>
			</div>
		}
		if w.Type.IsWeight() {
			<div class="chiffre majeur">
				<span class="valeur">
					{ helpers.HumanWeight(ctx, w.Weight()) }
					<span class="unite">{ preferredUnits.Weight() }</span>
				</span>
				<span class="libelle">{ i18n.T(ctx, "translation.Weight") }</span>
			</div>
		}
		if w.Type.IsRepetition() {
			<div class="chiffre majeur">
				<span class="valeur">{ helpers.A2S(w.Repetitions()) }</span>
				<span class="libelle">{ i18n.T(ctx, "translation.Repetitions") }</span>
			</div>
		}
	</div>
}
