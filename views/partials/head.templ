package partials

import "github.com/jovandeginste/workout-tracker/v2/views/helpers"

templ Head() {
	<title>Workout Tracker</title>
	<meta charset="UTF-8"/>
	<meta name="viewport" content="width=device-width, initial-scale=1"/>
	<link rel="icon" type="image/png" href={ helpers.RouteFor(ctx, "assets") + "/logo-small.png" }/>
	// Archivo pour les titres et les chiffres, Public Sans pour le texte courant.
	// Hors ligne, la pile de repli declaree dans tailwind.config.js prend le relais.
	<link rel="preconnect" href="https://fonts.googleapis.com"/>
	<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/>
	<link href="https://fonts.googleapis.com/css2?family=Archivo:wght@500;600;700;800&amp;family=Public+Sans:wght@400;500;600&amp;display=swap" rel="stylesheet"/>
	<link href={ helpers.RouteFor(ctx, "assets") + "/output.css" } rel="stylesheet"/>
	<script src={ helpers.RouteFor(ctx, "assets") + "/common.js" }></script>
	<script src={ helpers.RouteFor(ctx, "assets") + "/vendor/htmx/htmx.min.js" }></script>
	@Theme()
}
